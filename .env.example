# ── WaterQuest Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit it.

# NVIDIA NIM — AI analysis engine (DeepSeek-V4-Pro)
NVIDIA_API_KEY=[ PASTE YOUR NVIDIA NIM KEY HERE ]

# Copernicus Data Space — Sentinel-2 satellite data
COPERNICUS_CLIENT_ID=[ PASTE YOUR COPERNICUS CLIENT ID HERE ]
COPERNICUS_CLIENT_SECRET=[ PASTE YOUR COPERNICUS CLIENT SECRET HERE ]

# Supabase — database and real-time updates
SUPABASE_URL=https://[ YOUR PROJECT REF ].supabase.co
SUPABASE_ANON_KEY=[ PASTE YOUR SUPABASE ANON KEY HERE ]
SUPABASE_SERVICE_KEY=[ PASTE YOUR SUPABASE SERVICE KEY HERE ]

# Backend security
SECRET_KEY=[ RUN: openssl rand -hex 32  — PASTE RESULT HERE ]
ADMIN_PASSWORD=[ CHOOSE A STRONG ADMIN PASSWORD HERE ]

# Optional
SENDGRID_API_KEY=[ PASTE IF USING EMAIL NOTIFICATIONS ]
MAPBOX_TOKEN=[ PASTE IF SWITCHING FROM LEAFLET TO MAPBOX ]

# Frontend-only (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://[ YOUR PROJECT REF ].supabase.co
VITE_SUPABASE_ANON_KEY=[ PASTE YOUR SUPABASE ANON KEY HERE ]
VITE_API_URL=http://localhost:8000
